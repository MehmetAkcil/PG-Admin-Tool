# HTTP port (default 3840 if unset)
PORT=3840

# Optional: folder containing pg_dump.exe and psql.exe when they are not on PATH.
# Windows example:
# PG_BIN=C:\Program Files\PostgreSQL\16\bin
# Linux / macOS example:
# PG_BIN=/usr/lib/postgresql/16/bin

# Optional: same as PG_BIN (either may be used by the server)
# PGDIR=

# Node environment (development enables verbose tooling if added later)
# NODE_ENV=development
